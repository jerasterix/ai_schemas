{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Specification Output",
  "type": "object",
  "description": "Structured product information extracted or generated by the AI.",
  "properties": {
    "description": {
      "type": "string",
      "description": "All the text in the description field."
    },
    "weight": {
      "type": "string",
      "description": "All the text in the weight section."
    },
    "dimensions": {
      "type": "string",
      "description": "All the text in the dimensions section."
    },
    "box_case_pack": {
      "type": "string",
      "description": "All text in the box, case, and pack section."
    },
    "box_code": {
      "type": "integer",
      "description": "Box barcode or identification code."
    },
    "pack_code": {
      "type": "integer",
      "description": "Pack barcode or identification code."
    },
    "case_code": {
      "type": "integer",
      "description": "Case barcode or identification code."
    },
    "date": {
      "description": "Delivery date or TBD.",
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "enum": ["TBD"]
        }
      ]
    }
  },
  "required": [
    "description",
    "weight",
    "dimensions",
    "box_case_pack",
    "box_code",
    "pack_code",
    "case_code",
    "date"
  ],
  "additionalProperties": false
}
